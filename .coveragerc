# Used by `pytest --cov` and by `coverage run` (see README, "Running the tests").
[run]
source = src
branch = True
# Migrations are generated and run once per database; they are not unit tested.
omit =
    src/migrations/*

[report]
show_missing = True
skip_covered = True
# Every line and branch of the app must be exercised by a test.
fail_under = 100
