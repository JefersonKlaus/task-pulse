msgid ""
"<strong>date</strong>: dd/mm/aaaa ou aaaa-mm-dd. É o início da tarefa, e "
"também o término quando o status não é DOING."
msgstr ""
"<strong>date</strong>: dd/mm/yyyy or yyyy-mm-dd. The task's start, and also "
"its finish when the status is not DOING."

msgid "<strong>desc</strong>: nome da tarefa."
msgstr "<strong>desc</strong>: the task name."

msgid ""
"<strong>github</strong> (coluna opcional): o repositório do projeto da "
"tarefa, como <code>dono/repositorio</code> ou a URL. A tarefa vai para o "
"projeto desse repositório, que é criado se ainda não existir. Vazio = o "
"projeto escolhido abaixo."
msgstr ""
"<strong>github</strong> (optional column): the repository of the task's "
"project, as <code>owner/repository</code> or its URL. The task goes to that "
"repository's project, which is created if it doesn't exist yet. Blank = the "
"project chosen below."

msgid ""
"<strong>id</strong>: identificador da tarefa no sistema de origem. "
"Obrigatório e único por projeto no arquivo."
msgstr ""
"<strong>id</strong>: the task's id in the source system. Required, and unique"
" per project in the file."

msgid ""
"<strong>status</strong>: DOING, REVIEW, DONE ou REJECTED. Vazio = DOING."
msgstr ""
"<strong>status</strong>: DOING, REVIEW, DONE or REJECTED. Blank = DOING."

msgid ""
"<strong>time</strong>: horas com vírgula ou ponto (3,8 = 3:48), ou H:MM. "
"Vazio = 0."
msgstr ""
"<strong>time</strong>: hours with a comma or a dot (3,8 = 3:48), or H:MM. "
"Blank = 0."

msgid "A data de término não pode ser anterior ao início."
msgstr "The finish date can't be before the start."

msgid "A data final não pode ser anterior à inicial."
msgstr "The end date can't be before the start date."

